# Copy this file to config/mri_preproc.env and edit paths before running.

# Update the user name
USER_NAME='xxqian'

# Update the project name
#PROJECT_NAME='CoNNeCTLab_data_management'
PROJECT_NAME='IFOCUS'

# Project paths on Hyak.
# Generated derivatives use Fang scratch; inputs, logs, work, and caches stay
# under SCRUBBED_PROJECT_DIR on scrubbed storage.
DERIVATIVES_DIR="/gscratch/fang/${PROJECT_NAME}/derivatives"
SCRUBBED_PROJECT_DIR="/gscratch/scrubbed/fanglab/${USER_NAME}/${PROJECT_NAME}"
LOG_ROOT="${SCRUBBED_PROJECT_DIR}/logs"
WORK_ROOT="${SCRUBBED_PROJECT_DIR}/scratch"
# BIDS input must be the node-local directory exported by a Slurm Kopah stage.
# KOPAH_STAGED_BIDS_DIR serves HCP structural/functional and HippUnfold jobs;
# FMRIPREP_STAGED_BIDS_DIR serves fMRIPrep jobs.
# KOPAH_STAGED_BIDS_DIR takes precedence if both are set.
BIDS_DIR="${KOPAH_STAGED_BIDS_DIR:-${FMRIPREP_STAGED_BIDS_DIR:-}}"

# Optional Flywheel download selection. These settings do not limit fMRIPrep;
# fMRIPrep processes every image present in BIDS_DIR. Session labels must use
# BIDS `ses-` prefixes.
# Example: RELEASE_SESSION_LABELS="ses-baseline ses-repeatbaseline"
#          RELEASE_LABEL="ses-baseline_and_ses-repeatbaseline"
RELEASE_SESSION_LABELS="ses-baseline ses-repeatbaseline"
RELEASE_LABEL="ses-baseline_and_ses-repeatbaseline"
# Map BIDS labels to exact Flywheel labels only when they differ. Example:
# FLYWHEEL_SESSION_LABEL_MAP="ses-baseline=baseline ses-repeatbaseline=repeatbaseline"
FLYWHEEL_SESSION_LABEL_MAP="ses-baseline=ses-baseline ses-repeatbaseline=ses-repeatbaseline"
FMRIPREP_RELEASE_DIR="${DERIVATIVES_DIR}"
FMRIPREP_WORK_LABEL=""
FMRIPREP_OUT="${KOPAH_STAGED_FMRIPREP_OUT:-${FMRIPREP_RELEASE_DIR}/fmriprep}"
FS_SUBJECTS_DIR="${KOPAH_STAGED_FREESURFER_OUT:-${FMRIPREP_RELEASE_DIR}/freesurfer}"
WORK_DIR="${WORK_ROOT}/fmriprep${FMRIPREP_WORK_LABEL}"
LOG_DIR="${LOG_ROOT}/fmriprep${FMRIPREP_WORK_LABEL}"
PROVENANCE_DIR="${FMRIPREP_RELEASE_DIR}/qc/provenance"

# Hyak scheduler identity shared by all config-driven submissions.
HYAK_ACCOUNT="fang"
HYAK_PARTITION="ckpt-all"

# One-step fMRIPrep. This submits the canonical runner once per subject,
# processing anatomy and functional data together into FMRIPREP_OUT.
FMRIPREP_ONESTEP_TIME="72:00:00"
FMRIPREP_ONESTEP_CPUS="16"
FMRIPREP_ONESTEP_MEM_MB="128000"
# 0 means no Slurm array concurrency cap.
FMRIPREP_ONESTEP_ARRAY_CONCURRENCY="0"

# Durable Kopah storage. Keep keys only in KOPAH_S3CFG; never commit them.
KOPAH_S3CFG="/mmfs1/home/${USER_NAME}/.s3cfg"
KOPAH_SOURCE_DICOM_URI="s3://fang/${PROJECT_NAME}/sourcedata/dicom"
KOPAH_BIDS_URI="s3://fang/${PROJECT_NAME}/sourcedata/nii"
KOPAH_DERIVATIVES_URI="s3://fang/${PROJECT_NAME}/derivatives"
FMRIPREP_STAGE_FROM_KOPAH="0"
FMRIPREP_STAGE_ROOT="/scr/${USER}/r01-kopah-stage/fmriprep"
FMRIPREP_PUBLISH_TO_KOPAH="1"
# Remove only after fMRIPrep and FreeSurfer uploads have both been verified.
FMRIPREP_REMOVE_LOCAL_OUTPUT="1"
KOPAH_STAGE_BRANCHES="1"
KOPAH_BRANCH_STAGE_ROOT="/scr/${USER}/r01-kopah-stage/branches"
# Publish every eligible post-fMRIPrep branch independently of input staging.
KOPAH_PUBLISH_BRANCH_OUTPUTS="1"
KOPAH_REMOVE_LOCAL_BRANCH_OUTPUT="1"

# Required for FreeSurfer inside fMRIPrep.
FS_LICENSE="/mmfs1/home/${USER_NAME}/files/fs_license.txt"

# Hyak should use apptainer or singularity, not Docker.
CONTAINER_RUNTIME="apptainer"

# Freeze the exact image/digest for production.
# Apptainer/Singularity example: /project/containers/fmriprep-25.2.5.sif
FMRIPREP_IMAGE="/gscratch/fang/resources/images/fmriprep-25.2.5.sif"

# Python helper scripts are run inside this Hyak container.
PYTHON_CONTAINER_IMAGE="/gscratch/fang/resources/images/jupyter.sif"
PYTHON_CONTAINER_PYTHON="python3"

# Hyak's Apptainer configuration may include default SLURM bind paths that are
# absent on some nodes. Disable site/default bind paths and use explicit binds.
APPTAINER_NO_MOUNT="bind-paths"

# Shared TemplateFlow cache on Hyak.
TEMPLATEFLOW_HOME="/gscratch/fang/resources/templateflow"

# Participant selection for manual/non-array runs. Leave empty to run all
# participants in one fMRIPrep process. The one-step array submitter sets this
# automatically for subject-level parallel Hyak runs.
# Example: PARTICIPANT_LABELS="sub-001 sub-002"
PARTICIPANT_LABELS=""

# Production baseline choices from the MRI preprocessing plan.
SUBJECT_ANATOMICAL_REFERENCE="unbiased"
RANDOM_SEED="20260904"
SLICE_TIME_REF="0.5"

# Set to 1 only when intentionally using the stricter skull-strip reproducibility mode.
SKULL_STRIP_FIXED_SEED="0"

# Resource controls.
NTHREADS="16"
OMP_NTHREADS="8"
MEM_MB="64000"

# Hyak SLURM controls used by scripts/submit_fmriprep_hyak.sbatch.
# You can also override these directly in the sbatch command.
HYAK_TIME="48:00:00"

# Flywheel DICOM-download jobs use HYAK_PARTITION and these resource settings.
FLYWHEEL_DOWNLOAD_TIME="04:00:00"
FLYWHEEL_DOWNLOAD_CPUS="4"
FLYWHEEL_DOWNLOAD_MEM="8G"
FLYWHEEL_DOWNLOAD_JOBS="4"
FLYWHEEL_DOWNLOAD_LOG_DIR="${LOG_ROOT}/flywheel"

# Extra fMRIPrep flags can be appended here after they are explicitly frozen.
EXTRA_FMRIPREP_ARGS=""

# Specialized derivative branch outputs. These are intentionally separate from
# the canonical fMRIPrep derivative dataset.
HIPPUNFOLD_OUT="${DERIVATIVES_DIR}/hippunfold"
HIPPUNFOLD_WORK="${WORK_ROOT}/hippunfold"
HIPPUNFOLD_TMPDIR="/scr/${USER}/hippunfold_tmp"
HIPPUNFOLD_CACHE_DIR="/gscratch/fang/resources/hippunfold"
HIPPUNFOLD_IMAGE="/gscratch/fang/resources/images/hippunfold-2.0.0.sif"
HIPPUNFOLD_CONTAINER_ENTRYPOINT="/app/entrypoint.sh"
HIPPUNFOLD_CONTAINER_COMMAND="hippunfold"
# Read raw BIDS directly from BIDS_DIR by default. Set to 1 only to stage
# per-subject inputs from KOPAH_BIDS_URI on node-local scratch.
HIPPUNFOLD_STAGE_FROM_KOPAH="0"
HIPPUNFOLD_PARTICIPANT_LABELS=""
HIPPUNFOLD_MODALITY="T1w"
HIPPUNFOLD_TEMPLATE="CITI168"
HIPPUNFOLD_INJECT_TEMPLATE="upenn"
HIPPUNFOLD_BUILTIN_ATLAS="multihist7"
HIPPUNFOLD_CORES="${NTHREADS}"
HIPPUNFOLD_REQUIRE_CACHED_MODEL="1"
HIPPUNFOLD_REQUIRE_CACHED_RESOURCES="1"
EXTRA_HIPPUNFOLD_ARGS="--scheduler greedy"

FIRST_OUT="${DERIVATIVES_DIR}/first"
FIRST_WORK="${WORK_ROOT}/first"
FIRST_IMAGE="/gscratch/fang/resources/images/container_fsl_python.sif"
# List and stage per-subject fMRIPrep inputs from KOPAH_DERIVATIVES_URI.
# Set to 0 only when the local FMRIPREP_OUT is the intended FIRST input.
FIRST_STAGE_FROM_KOPAH="1"
FIRST_PARTICIPANT_LABELS=""
FIRST_T1W_GLOB="anat/*desc-preproc_T1w.nii.gz"
EXTRA_FIRST_ARGS=""

HCP_STRUCTURAL_OUT="${KOPAH_STAGED_HCP_OUT:-${DERIVATIVES_DIR}/hcp}"
HCP_STRUCTURAL_WORK="${WORK_ROOT}/hcp-structural"
HCP_STRUCTURAL_PARTICIPANT_LABELS=""
HCP_STRUCTURAL_ARRAY_CONCURRENCY="10"
HCP_STRUCTURAL_HYAK_TIME="72:00:00"
HCP_PROCESSING_MODE="HCPStyleData"
HCP_IMAGE="/gscratch/fang/resources/images/hcp-pipelines-5.0.0.sif"
HCP_BRAIN_SIZE="150"
HCP_GRAYORDINATES_RES="2"
HCP_HIGH_RES_MESH="164"
HCP_LOW_RES_MESH="32"
HCP_REG_NAME="MSMSulc"
HCP_STRUCTURAL_QC="yes"

HCP_FUNCTIONAL_WORK="${WORK_ROOT}/hcp-functional"
HCP_FUNCTIONAL_PARTICIPANT_LABELS=""
HCP_FUNCTIONAL_ARRAY_CONCURRENCY="10"
HCP_FUNCTIONAL_HYAK_TIME="48:00:00"
HCP_FUNCTIONAL_RUN_GLOB="func/*_bold.nii.gz"
HCP_FUNCTIONAL_RUN_INCLUDE_REGEX=""
HCP_FUNCTIONAL_RUN_EXCLUDE_REGEX="desc-|space-|_boldref"
HCP_FMRI_TOPUP_NEGATIVE_GLOB="fmap/*dir-AP*_epi.nii.gz"
HCP_FMRI_TOPUP_POSITIVE_GLOB="fmap/*dir-PA*_epi.nii.gz"
HCP_FMRI_TOPUP_NEGATIVE_IMAGE=""
HCP_FMRI_TOPUP_POSITIVE_IMAGE=""
HCP_FMRI_TOPUP_CONFIG=""
HCP_FMRI_ECHO_SPACING="0.00065"
HCP_FMRI_DISTORTION_CORRECTION="TOPUP"
HCP_FMRI_PROCESSING_MODE="HCPStyleData"
HCP_FMRI_BIAS_CORRECTION="LEGACY"
HCP_FMRI_RESOLUTION="2"
HCP_FMRI_SMOOTHING_FWHM="2"
HCP_FMRI_MC_TYPE="MCFLIRT"
HCP_FMRI_UNWARP_DIR_DEFAULT="y-"
HCP_FMRI_HIGH_PASS="0"
HCP_FMRI_CONCAT_NAME="fMRI_CONCAT"
HCP_FMRI_OUTPUT_NAME="${HCP_FMRI_CONCAT_NAME}"
HCP_FIX_MOTION_REGRESSION="TRUE"
HCP_FIX_TRAINING_FILE=""
HCP_FIX_THRESHOLD="10"
HCP_FIX_DELETE_INTERMEDIATES="FALSE"
HCP_FIX_ENABLE_LEGACY="FALSE"
HCP_FIX_CONCATENATE_ONLY="FALSE"
HCP_FIX_MATLAB_RUN_MODE="2"
